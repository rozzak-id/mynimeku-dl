# Base URL MyNimeku (jika domain berganti di masa mendatang)
MYNIMEKU_BASE_URL=https://www.mynimeku.com

# Lokasi custom folder penyimpanan unduhan (Opsional: secara default otomatis tersimpan ke folder Downloads laptop atau HP/Termux)
# DOWNLOAD_DIR=C:\Users\Username\Downloads
# DOWNLOAD_DIR=/sdcard/Download

# Resolusi default jika tidak dispesifikasikan (1080P, 720P, 480P, 360P)
DEFAULT_RESOLUTION=720P
